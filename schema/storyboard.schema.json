{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard",
  "description": "The contract between every pipeline stage.",
  "type": "object",
  "required": ["title", "logline", "language", "style_block", "character", "models", "voice", "music", "shots", "end_card"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "logline": {"type": "string", "minLength": 10},
    "language": {"type": "string", "description": "BCP-47 code of the narration language, e.g. am, om, ti, so, en"},
    "style_block": {"type": "string", "minLength": 10, "description": "Appended to every image prompt to lock the look."},
    "character": {
      "type": "object",
      "required": ["name", "description", "reference_prompt", "seed"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string", "minLength": 10, "description": "Identical text injected into every shot that shows the character."},
        "reference_prompt": {"type": "string"},
        "seed": {"type": "integer"}
      }
    },
    "models": {
      "type": "object",
      "required": ["image", "tts", "video"],
      "additionalProperties": false,
      "properties": {
        "image": {"type": "string"},
        "image_steps": {"type": "integer", "minimum": 1, "maximum": 50},
        "tts": {"type": "string"},
        "video": {"type": "string"},
        "video_resolution": {"type": "string", "enum": ["480p", "720p"]}
      }
    },
    "voice": {
      "type": "object",
      "required": ["name", "style"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "description": "Gemini prebuilt voice name"},
        "style": {"type": "string", "description": "Plain-language delivery instruction"}
      }
    },
    "music": {
      "type": "object",
      "required": ["caption", "bpm", "duration_s", "candidates", "chosen"],
      "additionalProperties": false,
      "properties": {
        "caption": {"type": "string"},
        "bpm": {"type": "integer", "minimum": 40, "maximum": 200},
        "key": {"type": "string"},
        "duration_s": {"type": "number", "minimum": 10, "maximum": 240},
        "candidates": {"type": "integer", "minimum": 1, "maximum": 8},
        "seeds": {"type": "array", "items": {"type": "integer"}},
        "chosen": {"type": ["string", "null"], "description": "Filename in outputs/music/ of the chosen candidate, or null for placeholder"},
        "volume": {"type": "number", "minimum": 0, "maximum": 2}
      }
    },
    "end_card": {
      "type": "object",
      "required": ["text", "duration_s"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "pattern": "(?i)\\bAI\\b"},
        "duration_s": {"type": "number", "minimum": 2, "maximum": 5}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "duration_s", "reason", "shot_size", "image_prompt", "motion_prompt", "seed", "narration", "narration_en", "music_cue"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
          "duration_s": {"type": "number", "minimum": 2, "maximum": 15},
          "reason": {"type": "string", "minLength": 10, "description": "Why this shot exists."},
          "shot_size": {"type": "string", "enum": ["extreme-wide", "wide", "medium", "medium-close-up", "close-up", "extreme-close-up", "insert"]},
          "uses_character": {"type": "boolean", "default": true},
          "image_prompt": {"type": "string", "minLength": 10},
          "motion_prompt": {"type": "string", "minLength": 3, "description": "Only motion + camera; the keyframe holds the subject."},
          "ken_burns": {"type": "string", "enum": ["zoom-in", "zoom-out", "pan-left", "pan-right"], "description": "Fallback motion when no Wan clip exists."},
          "seed": {"type": "integer"},
          "narration": {"type": "string", "description": "Line in the narration language. Empty string = no narration on this shot."},
          "narration_en": {"type": "string", "description": "English subtitle text."},
          "music_cue": {"type": "string", "enum": ["intro", "low", "build", "peak", "resolve", "silence"]}
        }
      }
    }
  }
}
